model DeliveryOrder {
  id                 Int                 @id @default(autoincrement())
  number             String              @unique
  date               DateTime
  sender             String?
  receiptNumber      String?
  pickUpBy           String?
  pickUpName         String?
  pickUpContact      String?
  supportingDocument Json?
  notes              String?             @db.Text
  status             DeliveryOrderStatus @default(Draft)

  // foreign keys
  companyId      Int
  salesOrderId   Int
  goodsReceiptId Int @unique
  customerId     Int
  userId         Int

  // timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations to other models
  Company            Company             @relation(fields: [companyId], references: [id])
  SalesOrder         SalesOrder          @relation(fields: [salesOrderId], references: [id])
  Customer           Customer            @relation(fields: [customerId], references: [id])
  User               User                @relation(fields: [userId], references: [id])
  DeliveryOrderItems DeliveryOrderItem[]
  GoodsReceipt       GoodsReceipt        @relation(fields: [goodsReceiptId], references: [id])
  Invoice            Invoice?

  @@index([companyId])
  @@index([salesOrderId])
  @@index([customerId])
  @@index([goodsReceiptId])
  @@index([userId])
  @@index([date])
  @@map("DeliveryOrders")
}

model DeliveryOrderItem {
  id               Int    @id @default(autoincrement())
  deliveryOrderId  Int
  partNumber       String @db.VarChar(100)
  partNumberSupply String @db.VarChar(100)
  description      String @db.Text
  quantityOrder    Int
  quantitySupply   Int

  // Relationships
  DeliveryOrder DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)

  @@index([deliveryOrderId])
  @@map("DeliveryOrderItems")
}

enum DeliveryOrderStatus {
  Draft
  Confirmed
}
