// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../../src/prisma/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        Int     @id @default(autoincrement())
  code      String  @unique @db.VarChar(10)
  name      String  @db.VarChar(50)
  address   String? @db.Text
  phone     String? @db.VarChar(20)
  isDefault Boolean @default(false)
  banks     Json[]

  // Relations to other models
  Nkp             Nkp[]
  ApprovalSetting ApprovalSetting[]
  Opportunity     Opportunity[]
  Lead            Lead[]
  VisitPlans      VisitPlan[]
  quotations      Quotation[]
  purchaseOrders  PurchaseOrder[]
  salesOrders     SalesOrder[]
  goodsReceipts   GoodsReceipt[]
  deliveryOrders  DeliveryOrder[]
  invoices        Invoice[]

  @@map("Companies")
}

model Department {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(10)
  name String @db.VarChar(50)
  User User[]

  @@map("Departments")
}

model Bank {
  id       Int        @id @default(autoincrement())
  code     String     @unique @db.VarChar(10)
  name     String     @db.VarChar(50)
  User     User[]
  Nkp      Nkp[]
  Supplier Supplier[]

  @@map("Banks")
}

enum PaymentStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_APPROVED
  FULLY_APPROVED
  REJECTED
  VERIFIED
  AUTHORIZED
  UNPAID
  PARTIAL
  PAID
  CLOSED
}

enum PaymentType {
  EMPLOYEE
  VENDOR
  TRANSFER_BALANCE
  TAX
  BILL
}

model AuthSession {
  id               Int       @id @default(autoincrement())
  jti              String    @unique @db.VarChar(36)
  refreshTokenHash String?   @unique @db.VarChar(64)
  userId           Int
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  User             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("AuthSessions")
}

model TwoFactorChallenge {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    Int
  codeHash  String   @db.VarChar(100)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("TwoFactorChallenges")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("PasswordResetTokens")
}

model AppLog {
  id        BigInt   @id @default(autoincrement())
  level     String   @db.VarChar(10)
  context   String?  @db.VarChar(100)
  message   String   @db.Text
  stack     String?  @db.Text
  meta      Json?    @db.JsonB
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([context, createdAt])
  @@map("AppLogs")
}
