model User {
  id                 Int      @id @default(autoincrement())
  name               String   @db.VarChar(50)
  code               String?  @db.Char(4)
  email              String   @unique @db.VarChar(50)
  password           String   @db.VarChar(100)
  active             Boolean  @default(true)
  twoFactorEnabled   Boolean  @default(false)
  bankAccount        String?  @db.VarChar(30)
  currency           Currency @default(IDR)
  signatureSpeciment Json?    @db.JsonB

  // Foreign key relations for the User model
  bankId       Int?
  departmentId Int?

  // 1:1 relation 
  Bank       Bank?        @relation(fields: [bankId], references: [id])
  Department Department?  @relation(fields: [departmentId], references: [id])
  Balance    UserBalance?

  // 1:many relations with other models
  roles        Role[]         @default([USER])
  Notification Notification[]
  AuthSession  AuthSession[]
  TwoFactorChallenge TwoFactorChallenge[]
  TrustedDevice TrustedDevice[]
  PasswordResetToken PasswordResetToken[]

  // NKP related
  NkpApproval NkpApproval[]
  Nkp         Nkp[]         @relation(name: "Nkp")
  NkpRequest  Nkp[]         @relation(name: "NkpRequest")

  // CRM related
  Leads         Lead[]
  Opportunities Opportunity[]
  Interactions  Interaction[]
  Tasks         Task[]
  VisitPlans    VisitPlan[]
  CustomerNotes CustomerNote[]
  Customers     Customer[]

  // Sales related
  Quotations  Quotation[]
  salesOrders SalesOrder[]
  Invoices    Invoice[]

  // Purchasing related
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  deliveryOrders DeliveryOrder[]

  // Accounting related
  accountingPayments    Payment[]
  journalEntriesCreated JournalEntry[]    @relation("JournalCreatedBy")
  journalEntriesPosted  JournalEntry[]    @relation("JournalPostedBy")
  closedPeriods         FiscalPeriod[]    @relation("PeriodClosedBy")
  vendorBillsCreated    VendorBill[]
  bankTransactions      BankTransaction[]

  // Approval related
  approvalItems       ApprovalItem[]
  ApprovalSettingItem ApprovalSettingItem[]

  @@index([bankId, departmentId])
  @@map("Users")
}

model UserBalance {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId      Int       @unique
  balance     Float     @default(0) @db.DoublePrecision
  description String?   @db.VarChar()
  updatedAt   DateTime? @updatedAt // kirim notifikasi apabila ada balance > 0 belum dilaporkan >= 7 hari

  @@index([userId])
  @@map("UserBalances")
}

enum Role {
  USER
  CASHIER
  FINANCE
  ACCOUNTING
  STAFF
  ADMIN
  SALES_REP
}
