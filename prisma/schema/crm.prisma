enum LeadStatus {
  New // Newly created lead
  Contacted // Initial contact made
  Qualified // Interested and a good fit
  Unqualified // Not interested or not a good fit
  Converted // Converted to Opportunity
}

enum LeadSource {
  Referral
  Advertisement
  SocialMedia
  Website
  ColdCall
  EmailCampaign
  Event
  Other
}

enum OpportunityStages {
  Prospecting // Initial stage of identifying potential customers
  Qualification // Qualifying the opportunity
  Proposal // Proposal development
  Negotiation // Discussing terms and conditions
  Proposal_Sent // Proposal has been sent to the customer
  Closed_Won // Opportunity has been won
  Closed_Lost // Opportunity has been lost
}

enum QuotationStatus {
  Draft // Quotation is being prepared
  Cancelled // Quotation has been cancelled
  Submitted // Quotation is submitted for internal approval
  PartiallyApproved // Quotation is partially approved
  Approved // Quotation is internally approved
  Declined // Quotation is internally declined
  Sent // Quotation has been sent to the customer
  Accepted // Customer has accepted the quotation
  Rejected // Customer has rejected the quotation
  Expired // Quotation validity period has expired
}

enum TaskStatus {
  Todo
  InProgress
  Completed
  Cancelled
  OnHold
}

enum TaskPriority {
  Low
  Medium
  High
  Urgent
}

enum InteractionType {
  Call
  Email
  Meeting
  Demo
  SiteVisit
  Presentation
  FollowUp
  Other
}

model Lead {
  id Int @id @default(autoincrement())

  title          String     @db.VarChar(200)
  customerId     Int?
  companyId      Int
  userId         Int
  source         LeadSource
  status         LeadStatus @default(New)
  estimatedValue Float?
  notes          String?    @db.Text
  convertedDate  DateTime?  @db.Timestamp()
  deletedAt      DateTime?  @db.Timestamp()

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  // Relationships
  Customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Company       Company       @relation(fields: [companyId], references: [id])
  User          User          @relation(fields: [userId], references: [id])
  Tasks         Task[]
  Interactions  Interaction[]
  opportunities Opportunity[]

  @@index([customerId])
  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([deletedAt])
  @@map("Leads")
}

model Opportunity {
  id                Int               @id @default(autoincrement())
  customerId        Int
  companyId         Int
  leadId            Int?
  userId            Int
  name              String            @db.VarChar(200)
  description       String?           @db.Text
  amount            Float
  probability       Int?              @db.SmallInt // 0-100
  stage             OpportunityStages
  expectedCloseDate DateTime
  actualCloseDate   DateTime?         @db.Timestamp()
  lostReason        String?           @db.Text
  attachments       Json?             @db.Json // For storing file metadata like name, path, size, type
  deletedAt         DateTime?         @db.Timestamp()

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  // Relationships
  Customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  User         User          @relation(fields: [userId], references: [id])
  Company      Company       @relation(fields: [companyId], references: [id])
  Quotations   Quotation[]
  Tasks        Task[]
  Interactions Interaction[]
  Lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([userId])
  @@index([companyId])
  @@index([stage])
  @@index([expectedCloseDate])
  @@index([deletedAt])
  @@map("Opportunities")
}

model Task {
  id            Int          @id @default(autoincrement())
  userId        Int
  leadId        Int?
  customerId    Int?
  opportunityId Int?
  title         String       @db.VarChar(200)
  description   String?      @db.Text
  dueDate       DateTime
  completedAt   DateTime?    @db.Timestamp()
  status        TaskStatus   @default(Todo)
  priority      TaskPriority @default(Medium)
  deletedAt     DateTime?    @db.Timestamp()
  attachments   Json?        @db.Json // For storing file metadata like name, path, size, type

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  // Relationships
  User        User         @relation(fields: [userId], references: [id])
  Lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  Customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("Tasks")
}

model Interaction {
  id            Int             @id @default(autoincrement())
  leadId        Int?
  opportunityId Int?
  contactId     Int?
  userId        Int
  type          InteractionType
  date          DateTime
  duration      Int?            @db.Integer // Duration in minutes
  subject       String?         @db.VarChar(200)
  notes         String?         @db.Text
  outcome       String?         @db.Text
  deletedAt     DateTime?       @db.Timestamp()

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  // Relationships
  Lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  Contact     Contact?     @relation(fields: [contactId], references: [id])
  User        User         @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([opportunityId])
  @@index([contactId])
  @@index([userId])
  @@index([type])
  @@index([date])
  @@index([deletedAt])
  @@map("Interactions")
}

model CustomerNote {
  id         Int       @id @default(autoincrement())
  customerId Int
  userId     Int
  content    String    @db.Text
  isPinned   Boolean   @default(false)
  deletedAt  DateTime? @db.Timestamp()

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  // Relationships
  Customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  User     User     @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([userId])
  @@index([deletedAt])
  @@map("CustomerNotes")
}

model CustomerFile {
  id          Int       @id @default(autoincrement())
  customerId  Int
  description String?   @db.Text
  category    String?   @db.VarChar(100) // e.g., contract, invoice, document
  fileName    String    @db.VarChar(255)
  filePath    String    @db.Text
  fileSize    Int       @db.Integer
  fileType    String    @db.VarChar(30)
  deletedAt   DateTime? @db.Timestamp()

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  // Relationships
  Customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([deletedAt])
  @@map("CustomerFiles")
}
