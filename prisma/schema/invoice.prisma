model Invoice {
  id              Int           @id @default(autoincrement())
  number          String        @unique
  referenceNumber String?
  date            DateTime
  dueDate         DateTime
  status          InvoiceStatus
  attachments     Json?         @db.JsonB // Attachments related to the invoice

  // financials
  totalAmount Float
  discount    Float
  vatAmount   Float
  grandTotal  Float

  // payment details
  paymentMethod String?
  termOfPayment String?

  // contact
  contactPerson String?
  contactPhone  String?
  contactEmail  String?

  // Relationships
  userId          Int
  salesOrderId    Int
  deliveryOrderId Int @unique
  customerId      Int

  Customer      Customer      @relation(fields: [customerId], references: [id])
  Payments      Payment[]
  SalesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id])
  DeliveryOrder DeliveryOrder @relation(fields: [deliveryOrderId], references: [id])
  User          User          @relation(fields: [userId], references: [id])
  InvoiceItems  InvoiceItem[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Invoices")
}

model InvoiceItem {
  id          Int    @id @default(autoincrement())
  invoiceId   Int
  partNumber  String
  description String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  // Relationships
  Invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("InvoiceItems")
}

enum InvoiceStatus {
  Draft
  Submitted
  Approved
  Sent
  Pending
  Paid
  Overdue
}
