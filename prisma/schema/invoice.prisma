model Invoice {
  id              Int           @id @default(autoincrement())
  number          String        @unique
  referenceNumber String?
  date            DateTime
  dueDate         DateTime
  status          InvoiceStatus
  billingAddress  String?
  shippingAddress String?
  attachments     Json?         @db.JsonB // Attachments related to the invoice
  receiptNumber   String?
  receiptDate     DateTime?
  receiptFile     Json?
  bank            Json?         @db.JsonB // Bank details related to the invoice

  // financials
  currency         Currency @default(IDR)
  totalAmount      Float
  discount         Float
  vatAmount        Float
  grandTotal       Float
  withTaxInvoice   Boolean  @default(true)
  taxInvoiceNumber String?

  // payment details
  paymentMethod String?
  termOfPayment String?

  // contact
  contactPerson String?
  contactPhone  String?
  contactEmail  String?

  // Relationships
  userId          Int
  salesOrderId    Int
  deliveryOrderId Int  @unique
  customerId      Int
  companyId       Int?

  Customer           Customer            @relation(fields: [customerId], references: [id])
  Company            Company?            @relation(fields: [companyId], references: [id])
  PaymentAllocations PaymentAllocation[]
  SalesOrder         SalesOrder          @relation(fields: [salesOrderId], references: [id])
  DeliveryOrder      DeliveryOrder       @relation(fields: [deliveryOrderId], references: [id])
  User               User                @relation(fields: [userId], references: [id])
  InvoiceItems       InvoiceItem[]

  // Timestamps
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  invoiceSubmissionItems InvoiceSubmissionItem[]

  @@map("Invoices")
}

model InvoiceItem {
  id          Int    @id @default(autoincrement())
  invoiceId   Int
  partNumber  String
  description String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  // Relationships
  Invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("InvoiceItems")
}

model InvoiceSubmission {
  id          Int                     @id @default(autoincrement())
  number      String                  @unique
  date        DateTime
  amount      Decimal                 @db.Decimal(18, 2)
  description String?
  status      InvoiceSubmissionStatus @default(Draft)

  // Timestamps for the InvoiceSubmission model
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?
  receivedAt  DateTime?
  paidAt      DateTime?

  // Foreign key relations for the InvoiceSubmission model
  userId     Int
  customerId Int

  // Relationships
  User                   User                    @relation(fields: [userId], references: [id])
  Customer               Customer                @relation(fields: [customerId], references: [id])
  invoiceSubmissionItems InvoiceSubmissionItem[]

  @@index([userId])
  @@index([customerId])
  @@map("InvoiceSubmissions")
}

model InvoiceSubmissionItem {
  id                  Int @id @default(autoincrement())
  invoiceSubmissionId Int
  invoiceId           Int

  // Relationships
  InvoiceSubmission InvoiceSubmission @relation(fields: [invoiceSubmissionId], references: [id], onDelete: Cascade)
  Invoice           Invoice           @relation(fields: [invoiceId], references: [id])

  @@index([invoiceSubmissionId])
  @@index([invoiceId])
  @@index([invoiceSubmissionId, invoiceId])
  @@map("InvoiceSubmissionItems")
}

enum InvoiceStatus {
  Draft
  Confirmed
  Sent
  Pending
  Paid
  Overdue
}

enum InvoiceSubmissionStatus {
  Draft
  Submitted
  Received
  Paid
}
