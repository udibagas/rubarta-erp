<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verification code</title>
  </head>
  <body>
    <h3>Dear <%= name %>,</h3>

    <p>Your verification code is:</p>

    <p style="font-size: 28px; font-weight: bold; letter-spacing: 6px">
      <%= code %>
    </p>

    <p>
      This code expires in <%= minutes %> minutes. If you did not try to sign
      in, please change your password.
    </p>

    <p>
      Regards,
      <br /><br />
      Rubarta ERP System
    </p>
  </body>
</html>
